{
  "mcpServers": {
    "rig": {
      "command": "sh",
      "args": [
        "-c",
        "exec sh \"${CODEX_HOME:-$HOME/.codex}/plugins/cache/rig/rig/0.1.0/rig.sh\" mcp"
      ],
      "env_vars": [
        "CODEX_HOME",
        "RIG_HOME",
        "RIG_CONFIG_HOME",
        "RIG_TRACE_FILE"
      ]
    }
  }
}
