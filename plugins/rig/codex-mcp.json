{
  "mcpServers": {
    "rig": {
      "args": [
        "-NoProfile",
        "-NonInteractive",
        "-Command",
        "[Console]::OutputEncoding = [Text.UTF8Encoding]::new($false); $profileRoot = $env:CODEX_HOME; if (-not $profileRoot) { $profileRoot = Join-Path $env:USERPROFILE \".codex\" }; $launcher = Join-Path $profileRoot \"plugins/cache/rig/rig/0.1.45422075647001/rig-launch.exe\"; & $launcher mcp; exit $LASTEXITCODE"
      ],
      "command": "powershell.exe",
      "env_vars": [
        "CODEX_HOME",
        "RIG_HOME",
        "RIG_CONFIG_HOME",
        "RIG_OFFLINE",
        "RIG_TRACE_FILE",
        "PATHEXT",
        "USERPROFILE",
        "PSModulePath"
      ],
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 11640
    }
  }
}
