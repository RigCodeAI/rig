{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/rig.sh\" plugin hook codex start",
            "commandWindows": "& (Join-Path $env:PLUGIN_ROOT 'rig-launch.exe') plugin hook codex start",
            "timeout": 23160
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/rig.sh\" plugin hook codex prompt",
            "commandWindows": "& (Join-Path $env:PLUGIN_ROOT 'rig-launch.exe') plugin hook codex prompt",
            "timeout": 23160
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/rig.sh\" plugin hook codex stop",
            "commandWindows": "& (Join-Path $env:PLUGIN_ROOT 'rig-launch.exe') plugin hook codex stop",
            "timeout": 23160
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/rig.sh\" plugin hook codex checkpoint",
            "commandWindows": "& (Join-Path $env:PLUGIN_ROOT 'rig-launch.exe') plugin hook codex checkpoint",
            "timeout": 23160
          }
        ]
      }
    ]
  }
}
