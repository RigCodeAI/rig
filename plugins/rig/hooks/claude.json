{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/rig-launch\" plugin hook claude start",
            "timeout": 23160
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/rig-launch\" plugin hook claude prompt",
            "timeout": 23160
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/rig-launch\" plugin hook claude stop",
            "timeout": 23160
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/rig-launch\" plugin hook claude checkpoint",
            "timeout": 23160
          }
        ]
      }
    ]
  }
}
